[Desktop Entry]
Version=1.0
Name=珠算
Comment=PrimordialWeave zhusuan Desktop App
# The Exec line includes %u to pass the URL to the application
Exec=/usr/local/bin/zhusuan %u
Terminal=false
Type=Application
Icon=zhusuan
Categories=Utility;
StartupWMClass=zhusuan
Actions=quick-receipt;new-project;calendar;

[Desktop Action quick-receipt]
Name=记一笔收款
Exec=/usr/local/bin/zhusuan --action=quick-receipt

[Desktop Action new-project]
Name=新建项目
Exec=/usr/local/bin/zhusuan --action=new-project

[Desktop Action calendar]
Name=收款日历
Exec=/usr/local/bin/zhusuan --action=calendar

 
