<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="zhusuan"
        Arguments=""
        InstallLocation="C:\Program Files\PrimordialWeave\zhusuan">
    </Installer>
    <PackageInformation
        PackageName="zhusuan"
        PackageDisplayName="珠算"
        PublisherName="CN=PrimordialWeave"
        PublisherDisplayName="PrimordialWeave"
        Version="1.0.1.0"
        PackageDescription="PrimordialWeave zhusuan Desktop App">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="org.primordialweave.zhusuan"
                Description="PrimordialWeave zhusuan Desktop App"
                DisplayName="珠算"
                ExecutableName="zhusuan"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>珠算</DisplayName>
            <PublisherDisplayName>PrimordialWeave</PublisherDisplayName>
            <Description>PrimordialWeave zhusuan Desktop App</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="zhusuan.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
